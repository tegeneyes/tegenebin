# New Supabase project
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# Public deployment URL used by Telegram webhook replies
APP_URL=https://<your-vercel-domain>

# Comma-separated Telegram user IDs
ADMIN_TELEGRAM_IDS=<telegram-admin-id>
TELEGRAM_BOT_TOKEN=<server-only-telegram-bot-token>
TELEGRAM_WEBHOOK_SECRET=<random-webhook-secret>

# Deposits: manual admin review by default. Set to true to auto-verify via Veritas.
DEPOSIT_AUTO_VERIFY=true
VERITAS_ENABLED=true
VERITAS_API_URL=https://verifyapi.leulzenebe.pro
VERITAS_API_KEY=<server-only-veritas-key>
# Optional overrides
# VERITAS_TELEBIRR_PATH=/verify-telebirr
# VERITAS_CBE_PATH=/verify-cbe
VERITAS_DEST_ACCOUNT=<telebirr-phone|cbe-account>
VERITAS_DEST_NAME=<account-holder-name>
MIN_DEPOSIT=50
MAX_DEPOSIT=100000
